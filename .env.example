# ── Supabase (server-side only — set in Vercel, never expose service role to the client) ──
# Must be the SAME project as the Ridely mobile app (riders, deliveries, waitlist, etc.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (server-side only) ──
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Ridely <hello@ridelyweb.com>

# Optional: where new signup notifications are sent (defaults to Ridely.inc@gmail.com)
ADMIN_NOTIFY_EMAIL=Ridely.inc@gmail.com

# ── Admin dashboard (server-side only) ──
ADMIN_PASSWORD=choose-a-strong-password
# Optional: separate secret for signing session tokens (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=another-long-random-string

# Optional: restrict CORS (comma-separated origins). Leave unset for same-origin only in production.
# ALLOWED_ORIGIN=https://ridelyweb.com,https://www.ridelyweb.com

# ── Frontend (optional, for local dev against a deployed API) ──
# VITE_API_URL=https://ridelyweb.com
